# Zoom Meeting SDK (staging)
# Set these values in the ignored .env file on the staging server. Never commit
# the Client Secret or place it in the session records.
zoom.clientId =
zoom.clientSecret =
# Use the exact Meeting SDK Web version approved for the Zoom app.
zoom.sdkVersion =

# Bunny Stream (required for direct video uploads). The Pull Zone host is used
# only for transparent WebM avatars, so their alpha channel bypasses the player.
bunny.streamLibraryId =
bunny.streamApiKey =
bunny.streamPullZone =

# Portal WebSocket service (session chat and instant notifications)
# websocket.url must be a public secure URL, normally routed by Apache/Nginx
# to the local listener. Do not expose the listener port publicly.
websocket.url = wss://portal.example.com/ws
websocket.bindHost = 127.0.0.1
websocket.port = 8081
# Generate with: openssl rand -hex 32
websocket.secret =

# Redis is used to queue events from PHP requests to the WebSocket process.
redis.host = 127.0.0.1
redis.port = 6379
redis.password =
redis.database = 0
