# Zoom Meeting SDK (staging)
# Set these values in the ignored .env file on the staging server. Never commit
# the Client Secret or place it in the session records.
zoom.clientId =
zoom.clientSecret =
# Use the exact Meeting SDK Web version approved for the Zoom app.
zoom.sdkVersion =

# Bunny Stream (required for direct video uploads). The Pull Zone host is used
# only for transparent WebM avatars, so their alpha channel bypasses the player.
bunny.streamLibraryId =
bunny.streamApiKey =
bunny.streamPullZone =

# Portal WebSocket service (session chat and instant notifications)
# websocket.url must be a public secure URL, normally routed by Apache/Nginx
# to the local listener. Do not expose the listener port publicly.
websocket.url = wss://portal.example.com/ws
websocket.bindHost = 127.0.0.1
websocket.port = 8081
# Generate with: openssl rand -hex 32
websocket.secret =

# Redis is used to queue events from PHP requests to the WebSocket process.
redis.host = 127.0.0.1
redis.port = 6379
redis.password =
redis.database = 0

# Stripe Checkout for the Emergence Store. Keep these values only in the server .env.
stripe.secretKey =
stripe.webhookSecret =

# Brevo transactional email delivery. Verify the sender address/domain in Brevo
# first, then copy the SMTP Login and SMTP Key from Settings > SMTP & API.
# Use an SMTP Key here, never a Brevo API key or your Brevo account password.
email.fromEmail =
email.fromName = "EPR Global Events"
email.protocol = smtp
email.SMTPHost = smtp-relay.brevo.com
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPTimeout = 20
email.mailType = html
email.charset = utf-8
email.wordWrap = true

# Tawk.to live support (from Administration > Chat Widget in your Tawk dashboard)
tawk.propertyId =
tawk.widgetId =
